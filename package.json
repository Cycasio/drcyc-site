{
  "name": "drcyc-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "test": "node --test scripts/*.test.ts",
    "check:terms": "node scripts/check-taiwan-terms.mjs",
    "check:schema-dates": "node scripts/check-structured-dates.mjs dist",
    "prebuild": "npm run check:terms",
    "postbuild": "node scripts/check-taiwan-terms.mjs dist && npm run check:schema-dates && npm run check:geo && npm run check:security",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "astro": "astro",
    "check:geo": "node scripts/check-geo-build.mjs",
    "check:security": "node scripts/check-security-build.mjs",
    "check:functions": "tsc -p config/functions.tsconfig.json",
    "check:release-stage": "node scripts/check-release-stage.mjs",
    "types:events": "wrangler types config/site-events-env.d.ts --config config/analytics-types.wrangler.jsonc --env-interface SiteEventsEnv --include-runtime=false --strict-vars=false"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/markdown-remark": "7.3.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.26.0",
    "typescript": "^5.9.3",
    "wrangler": "4.151.1"
  }
}
