{
  "name": "drcyc-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "test": "node --test scripts/*.test.ts",
    "check:terms": "node scripts/check-taiwan-terms.mjs",
    "check:schema-dates": "node scripts/check-structured-dates.mjs dist",
