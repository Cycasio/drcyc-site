---
import Layout from '../../layouts/Layout.astro';
import { TOOLS, TOOL_GROUPS, TOOLS_SITE, TOOLS_DASHBOARD_URL } from '../../data/tools';

const title = '醫療計算工具總覽｜減重 / 代謝 / 心血管 / 職場健康風險｜陳昱彰醫師';
const description = '義大醫院家醫科陳昱彰醫師整理的 12 個線上醫療計算工具：BMI、TDEE、體脂率、GLP-1 適應症、Framingham、10 年與 30 年心血管風險及過勞風險等；每項工具均標示公式來源、適用限制與資料處理方式。';

// 臨床風險評估計算機（位於 /blog/health-tools/，配有完整衛教文）
const riskTools = [
  {
    href: '/blog/health-tools/fib4-calculator/',
    title: 'FIB-4 肝纖維化指數計算機',
    emoji: '🩻',
    audience: '脂肪肝 MASLD 纖維化風險自評',
    description: '輸入年齡、AST（GOT）、ALT（GPT）、血小板，免費估算脂肪肝的進階肝纖維化風險。< 1.3 低風險、1.3–2.67 需 FibroScan、> 2.67 應轉肝膽科（65 歲以上採 2.0 切點）。採 Sterling（2006）公式與 AGA／AASLD 切點。',
  },
  {
    href: '/blog/health-tools/cardiovascular-risk-estimator/',
    title: '10 年與 30 年心血管風險估算工具',
    emoji: '❤️',
    audience: '10 年：30–79 歲；30 年：30–59 歲',
    description: '本站採經獲准使用的 1.0.0 基本模型，分別估算 Total CVD、ASCVD 與心臟衰竭的 10 年及 30 年風險；納入 eGFR，心臟衰竭方程另納入 BMI。',
  },
  {
    href: '/blog/health-tools/cv-risk-calculator/',
    title: 'Framingham ATP III 心血管風險',
    emoji: '🩺',
    audience: '20–79 歲，經典心血管風險工具',
    description: '美國 NIH NHLBI 採用的經典 Framingham 風險計算機（ATP III 版），估算 10 年內心血管事件（心肌梗塞、冠心症死亡）的風險百分比，臨床上仍廣泛使用。',
  },
  {
    href: '/blog/health-tools/overwork-risk-calculator/',
    title: '過勞風險評估計算機',
    emoji: '⚠️',
    audience: '勞工健康四大計畫：過勞預防',
    description: '依勞動部「異常工作負荷促發疾病預防指引」附表 8 整理，輸入加班時數、輪班、CBI 過勞分數，自動評估你的過勞風險等級與後續建議。',
  },
];

const collectionSchema = {
  '@type': 'CollectionPage',
  '@id': `${TOOLS_SITE}/tools/#collection`,
  url: `${TOOLS_SITE}/tools/`,
  name: '醫療計算工具總覽',
  description,
  inLanguage: 'zh-Hant',
  hasPart: [
    ...TOOLS.map((t) => ({
      '@type': 'SoftwareApplication',
      name: t.pageHeading,
      url: t.url,
      applicationCategory: 'HealthApplication',
    })),
    ...riskTools.map((t) => ({
      '@type': 'SoftwareApplication',
      name: t.title,
      url: `${TOOLS_SITE}${t.href}`,
      applicationCategory: 'HealthApplication',
    })),
  ],
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: `${TOOLS_SITE}/` },
    { '@type': 'ListItem', position: 2, name: '醫療計算機', item: `${TOOLS_SITE}/tools/` },
  ],
};
---

<Layout title={title} description={description} jsonLd={[collectionSchema, breadcrumb]}>
  <main class="max-w-6xl mx-auto px-6 md:px-10 py-12">
    <nav class="text-xs text-slate-500 mb-6" aria-label="breadcrumb">
      <a href="/" class="hover:text-teal-700">首頁</a>
      <span class="mx-2">／</span>
      <span>醫療計算機</span>
    </nav>

    <header class="mb-10">
      <p class="text-xs font-bold tracking-widest text-teal-700 uppercase mb-3">Medical Calculators · 陳昱彰醫師</p>
      <h1 class="text-3xl md:text-4xl font-bold text-blue-950 mb-3 font-headline">
        醫療計算工具總覽
      </h1>
      <p class="text-slate-600 chinese-line-height max-w-3xl">
        家醫科 / 肥胖醫學 / 心血管 / 職業醫學常用的 12 個臨床指標與風險評估，採用衛福部國民健康署、美國心臟協會、勞動部與國際公認標準，附臨床點評。多數工具在瀏覽器內運算；需要站內端點的工具會另外清楚標示。
      </p>
    </header>

    <section class="mb-12">
      <a
        href="/tools/dashboard/"
        class="block rounded-3xl bg-gradient-to-br from-primary to-primary-container text-on-primary p-6 md:p-8 hover:opacity-95 transition-opacity no-underline"
      >
        <div class="flex items-start gap-4">
          <span class="text-4xl">🩺</span>
          <div class="flex-1">
            <p class="text-xs font-bold uppercase tracking-widest mb-2 opacity-80">推薦入口</p>
            <h2 class="text-xl md:text-2xl font-bold mb-2 font-headline">減重綜合儀表板</h2>
            <p class="text-on-primary-container chinese-line-height">
              一頁全部算完——BMI、理想體重、TDEE、體脂、腰圍指標、GLP-1 評估、減重進度。診間可直接列印給患者帶走。
            </p>
          </div>
        </div>
      </a>
    </section>

    {TOOL_GROUPS.map((group) => (
      <section class="mb-10">
        <h2 class="text-xl font-bold text-blue-950 mb-4 font-headline">{group.category}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {group.tools.map((t) => (
            <a
              href={t.url.replace(TOOLS_SITE, '')}
              class="block p-5 rounded-2xl bg-white border border-outline-variant hover:border-primary hover:shadow-md transition-all no-underline"
            >
              <span class="text-3xl">{t.emoji}</span>
              <h3 class="text-base font-bold text-blue-950 mt-3 font-headline">{t.shortLabel}</h3>
              <p class="text-xs text-teal-700 font-medium mt-1">適合：{t.audience}</p>
              <p class="text-sm text-slate-600 mt-2 chinese-line-height line-clamp-3">{t.description}</p>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="mb-10">
      <div class="flex items-end justify-between mb-4 gap-4 flex-wrap">
        <h2 class="text-xl font-bold text-blue-950 font-headline">臨床風險評估</h2>
        <p class="text-xs text-slate-500">每個工具皆配有完整衛教說明</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {riskTools.map((t) => (
          <a
            href={t.href}
            class="block p-5 rounded-2xl bg-white border border-outline-variant hover:border-primary hover:shadow-md transition-all no-underline"
          >
            <span class="text-3xl">{t.emoji}</span>
            <h3 class="text-base font-bold text-blue-950 mt-3 font-headline">{t.title}</h3>
            <p class="text-xs text-teal-700 font-medium mt-1">適合：{t.audience}</p>
            <p class="text-sm text-slate-600 mt-2 chinese-line-height line-clamp-4">{t.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-12 rounded-2xl bg-surface-container p-6 md:p-8">
      <h2 class="text-lg font-bold text-blue-950 mb-3 font-headline">關於這些計算機</h2>
      <ul class="text-sm text-slate-700 chinese-line-height list-disc pl-5 space-y-1">
        <li><strong>公式來源</strong>：BMI 分級採衛福部國健署成人標準；BMR 採 Mifflin-St Jeor（1990）；體脂率採 Deurenberg（1991）；GLP-1 適應症採國際肥胖學會與 FDA 標示常用門檻。</li>
        <li><strong>隱私</strong>：多數生活型工具只在瀏覽器內處理，部分功能可選擇以 localStorage 保存。本頁的 10 年與 30 年心血管風險估算會送至本站同源端點進行單次運算，但本站應用程式不保存輸入或結果。</li>
        <li><strong>限制</strong>：本站計算機僅供健康評估參考，不能取代醫師診斷與治療建議。</li>
      </ul>
    </section>
  </main>
</Layout>
