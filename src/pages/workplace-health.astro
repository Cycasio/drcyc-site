---
import Layout from '../layouts/Layout.astro';

const services = [
  { icon: '👨‍⚕️', title: '醫師臨場服務', desc: '依企業適用法規、規模與風險安排服務，提供勞工健康諮詢、職業病預防指導、工作適性評估與健康管理建議。' },
  { icon: '📋', title: '勞工健檢規劃', desc: '協助企業規劃一般健檢與特殊健檢項目，健檢結果判讀、異常追蹤與分級管理。' },
  { icon: '⚠️', title: '職場危害評估', desc: '現場作業環境巡視，辨識物理、化學、人因性危害因子，提供改善建議與風險控管方案。' },
  { icon: '🛡️', title: '職業傷病預防', desc: '肌肉骨骼疾病、過勞預防、異常工作負荷管理，協助企業建立預防機制。' },
  { icon: '🧠', title: '職場心理健康', desc: '壓力管理、員工協助方案(EAP)諮詢、職場霸凌預防與心理健康促進。' },
  { icon: '📊', title: '健康管理系統', desc: '導入數位化員工健康管理平台，追蹤健康資料、推播衛教內容並管理慢性病。' },
];

const articles = [
  {
    href: '/blog/four-plans-occupational-health-overview/',
    tag: '法規總覽',
    title: '職安法四大計畫是什麼？哪些企業要做、勞動部查什麼',
    desc: '一文搞懂四大計畫法源、適用門檻、稽查重點，以及為什麼套範本不算數。',
  },
  {
    href: '/blog/overwork-prevention-plan/',
    tag: '過勞預防',
    title: '異常工作負荷促發疾病預防計畫：從評估到執行',
    desc: '月加班幾小時算高風險？計畫書要寫什麼？稽查員最常抓的五個缺失。',
  },
  {
    href: '/blog/ergonomic-hazard-prevention-plan/',
    tag: '人因危害',
    title: '人因性危害預防計畫：辦公室與工廠各怎麼做',
    desc: '從 REBA/RULA 風險評估到工程改善，兩種職場的實作差異一次說清楚。',
  },
  {
    href: '/blog/workplace-violence-prevention-plan/',
    tag: '不法侵害',
    title: '職場不法侵害預防計畫：HR 最常問的問題',
    desc: '客戶辱罵算嗎？主管霸凌怎麼處理？事件後的心理支持流程。',
  },
  {
    href: '/blog/maternity-protection-plan/',
    tag: '母性保護',
    title: '母性保護計畫：從危害評估到工作調整的完整流程',
    desc: '妊娠中與分娩後未滿一年的法定保護、危害評估與工作調整；並釐清人工生殖療程的不同法律定位。',
  },
  {
    href: '/blog/hearing-conservation-program/',
    tag: '聽力保護',
    title: '聽力保護計畫：噪音作業場所一次搞懂',
    desc: '85 dB 門檻、NRR 值計算、特殊健檢頻率、分級管理，製造業必讀。',
  },
];

const faqs = [
  { q: '什麼是臨場健康服務？企業為什麼需要？', a: '依據《勞工健康保護規則》，企業須依勞工人數、特別危害健康作業與事業類別核對醫護配置。服務可包含健康諮詢、職業病預防與工作適性評估；實際方式及頻率應依最新條文與附表判定。' },
  { q: '服務範圍涵蓋哪些地區？', a: '主要服務高雄市、屏東縣企業，包括但不限於楠梓加工區、屏東工業區、臨海工業區等。其他地區歡迎來信洽詢。' },
  { q: '臨場服務的頻率和費用？', a: '法定配置與頻率應依《勞工健康保護規則》最新條文及附表，綜合人數、危害作業與事業類別判定。費用則依服務內容與實際頻率議定，歡迎來信洽詢。' },
  { q: '可以協助處理職業傷病認定嗎？', a: '可先協助整理工作史、暴露資料與健康狀況，進行工作與健康相關性的初步評估，並提供復工與工作調整建議。若涉及正式職業病診斷、因果關係認定或特定證明文件，會依個案需求轉介職業醫學科專科醫師或職業傷病診治專責醫療機構。' },
  { q: '如何開始合作？', a: '請來信 cyc@edfm.org 或透過 Facebook 粉專聯絡，將安排初步需求訪談，了解貴公司規模、產業類型與現有健康管理現況後，提供客製化服務方案。' },
];
---

<Layout
  title="企業臨場健康服務｜職業醫學｜陳昱彰醫師"
  description="高雄屏東企業臨場健康服務。陳昱彰醫師為家庭醫學科專科醫師、職業醫學科訓練醫師，具勞工健康服務醫師資格；提供健檢管理、危害評估與職業傷病預防。"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "企業臨場健康服務",
    "provider": { "@id": "https://www.drcyc.io/#person" },
    "areaServed": ["高雄市", "屏東縣"],
    "description": "依據勞工健康保護規則，提供企業臨場健康服務，包含醫師臨場諮詢、勞工健檢規劃、職場危害評估、職業傷病預防等。",
    "url": "https://www.drcyc.io/workplace-health/"
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />

  <main>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <p class="hero-badge">Workplace Health Services</p>
      <h1>企業臨場健康服務</h1>
      <p class="hero-subtitle">家庭醫學科專科醫師・職業醫學科訓練醫師<br/>具勞工健康服務醫師資格・高雄與屏東地區</p>
      <a href="#contact" class="btn btn-primary">洽詢合作</a>
    </div>
  </section>

  <!-- Why -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">為什麼選擇我們？</h2>
      <div class="about-content">
        <p>
          陳昱彰醫師為<strong>家庭醫學科專科醫師</strong>，現正接受<strong>職業醫學科專科訓練</strong>，並具勞工健康服務醫師資格；尚未取得職業醫學科專科醫師資格。
          不僅熟悉法規要求，更以<strong>行為科學</strong>為基礎，
          協助企業建立真正有效的員工健康管理機制——不只是紙上合規，
          而是讓健康促進真正落實。
        </p>
        <p>
          結合<strong>數位健康管理平台</strong>，提供健檢資料追蹤、
          個人化衛教推播、慢性病管理等服務，讓臨場服務的效果延續到日常。
        </p>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">服務項目</h2>
      <div class="grid">
        {services.map(s => (
          <div class="card">
            <span class="card-icon">{s.icon}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Articles -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">職業醫學衛教文章</h2>
      <p style="text-align:center;color:var(--text-light);margin-top:-2rem;margin-bottom:2.5rem;font-size:1rem;">
        四大計畫、聽力保護的完整說明——給 HR、安衛人員、工廠主管
      </p>
      <div class="articles-grid">
        {articles.map(a => (
          <a href={a.href} class="article-card">
            <span class="article-tag">{a.tag}</span>
            <h3>{a.title}</h3>
            <p>{a.desc}</p>
            <span class="article-read">閱讀全文 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">常見問題</h2>
      <div class="faq-list">
        {faqs.map(f => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section section-alt">
    <div class="container" style="text-align:center;">
      <h2 class="section-title">聯絡洽詢</h2>
      <p style="font-size:1.1rem;color:var(--text-light);margin-bottom:1.5rem;">
        歡迎企業來信洽詢臨場健康服務方案
      </p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <!--email_off--><a href="mailto:cyc@edfm.org" class="btn btn-primary">📧 cyc@edfm.org</a><!--/email_off-->
        <a href="https://www.facebook.com/lazydr" target="_blank" rel="noopener" class="btn btn-outline">Facebook 粉專</a>
      </div>
    </div>
  </section>
  </main>

</Layout>

<style>
  .page-hero { padding:5rem 0 4rem;background:linear-gradient(135deg,#f0f5ff 0%,#e8f0fe 100%);text-align:center; }
  .page-hero h1 { font-size:2.5rem;font-weight:800;margin-bottom:1rem; }
  .hero-badge { display:inline-block;background:var(--primary);color:white;padding:0.35rem 1rem;border-radius:99px;font-size:0.85rem;font-weight:600;margin-bottom:1.5rem; }
  .hero-subtitle { font-size:1.15rem;color:var(--text-light);margin-bottom:2rem; }

  .btn { display:inline-block;padding:0.75rem 1.75rem;border-radius:8px;font-weight:600;font-size:0.95rem;transition:all 0.2s; }
  .btn:hover { text-decoration:none; }
  .btn-primary { background:var(--primary);color:white; }
  .btn-primary:hover { background:var(--primary-dark); }
  .btn-outline { border:2px solid var(--primary);color:var(--primary); }
  .btn-outline:hover { background:var(--primary);color:white; }

  .section { padding:5rem 0; }
  .section-alt { background:var(--bg-light); }
  .section-title { font-size:2rem;font-weight:700;text-align:center;margin-bottom:3rem; }

  .about-content { max-width:700px;margin:0 auto;font-size:1.1rem;color:var(--text-light); }
  .about-content p { margin-bottom:1rem; }
  .about-content strong { color:var(--text); }

  .grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.5rem; }
  .card { background:white;padding:2rem;border-radius:var(--radius);border:1px solid var(--border);transition:box-shadow 0.2s; }
  .card:hover { box-shadow:0 4px 20px rgba(0,0,0,0.08); }
  .card-icon { font-size:2rem;display:block;margin-bottom:0.75rem; }
  .card h3 { font-size:1.1rem;margin-bottom:0.5rem; }
  .card p { color:var(--text-light);font-size:0.95rem; }

  .faq-list { max-width:700px;margin:0 auto; }
  .faq-item { border:1px solid var(--border);border-radius:var(--radius);margin-bottom:1rem;overflow:hidden; }
  .faq-item summary { padding:1.25rem 1.5rem;cursor:pointer;font-weight:600;font-size:1.05rem;list-style:none; }
  .faq-item summary::-webkit-details-marker { display:none; }
  .faq-item summary::before { content:'＋ ';color:var(--primary); }
  .faq-item[open] summary::before { content:'－ '; }
  .faq-item p { padding:0 1.5rem 1.25rem;color:var(--text-light); }

  .articles-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.25rem; }
  .article-card { display:flex;flex-direction:column;gap:0.5rem;background:white;padding:1.75rem;border-radius:var(--radius);border:1px solid var(--border);text-decoration:none;color:var(--text);transition:box-shadow 0.2s; }
  .article-card:hover { box-shadow:0 4px 20px rgba(0,0,0,0.08);text-decoration:none; }
  .article-tag { display:inline-block;background:var(--primary);color:white;padding:0.2rem 0.65rem;border-radius:99px;font-size:0.75rem;font-weight:600;width:fit-content; }
  .article-card h3 { font-size:1rem;font-weight:700;line-height:1.4;margin:0; }
  .article-card p { color:var(--text-light);font-size:0.9rem;line-height:1.55;flex:1;margin:0; }
  .article-read { font-size:0.85rem;font-weight:600;color:var(--primary); }

  @media (max-width:768px) {
    .page-hero h1 { font-size:1.8rem; }
    .section { padding:3rem 0; }
  }
</style>
