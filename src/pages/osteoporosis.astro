---
import Layout from '../layouts/Layout.astro';

const SITE = 'https://www.drcyc.io';
const title = '高雄骨質疏鬆門診｜骨密度與骨折風險評估｜陳昱彰醫師';
const description = '高雄骨質疏鬆評估：由義大醫院家醫科主治醫師陳昱彰（具中華民國骨質疏鬆症學會認證）整合骨密度 DXA、骨折風險、次發原因、用藥與跌倒預防。';

const faqs = [
  {
    q: '骨密度偏低就一定要吃藥嗎？',
    a: '不一定。是否治療需合併骨密度結果、是否有脆弱性骨折、年齡、其他風險因子與整體健康狀況判斷，不能只看一個 T-score。',
  },
  {
    q: '做 DXA 骨密度檢查會痛嗎？',
    a: 'DXA 是非侵入性的低劑量 X 光檢查，通常不需要打針。實際安排、禁忌與注意事項請依檢查單位說明。',
  },
  {
    q: '多久需要追蹤一次骨密度？',
    a: '沒有所有人通用的固定間隔。醫師會依初次結果、年齡、骨折風險、是否接受治療及檢查目的決定；過度頻繁檢查不一定能提供更多有效資訊。',
  },
  {
    q: '看骨鬆門診要帶哪些資料？',
    a: '可攜帶過去 DXA 報告、X 光或骨折紀錄、近期抽血、目前藥物與保健品清單。若曾長期使用類固醇、接受癌症治療或有內分泌疾病，也請主動告知。',
  },
];

const schemas = [
  {
    '@type': 'MedicalWebPage',
    '@id': `${SITE}/osteoporosis/#webpage`,
    url: `${SITE}/osteoporosis/`,
    name: title,
    description,
    inLanguage: 'zh-Hant',
    isPartOf: { '@id': `${SITE}/#website` },
    author: { '@id': `${SITE}/#person` },
    about: { '@type': 'MedicalCondition', name: '骨質疏鬆症' },
    mainEntity: { '@id': `${SITE}/osteoporosis/#service` },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: '服務項目', item: `${SITE}/services/` },
        { '@type': 'ListItem', position: 3, name: '骨質疏鬆門診', item: `${SITE}/osteoporosis/` },
      ],
    },
  },
  {
    '@type': 'Service',
    '@id': `${SITE}/osteoporosis/#service`,
    name: '骨質疏鬆評估與照護',
    serviceType: '骨質疏鬆與骨折風險評估',
    provider: { '@id': `${SITE}/#person` },
    availableChannel: {
      '@type': 'ServiceChannel',
      serviceLocation: { '@id': `${SITE}/#edah-clinic` },
    },
  },
  {
    '@type': 'FAQPage',
    '@id': `${SITE}/osteoporosis/#faq`,
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<Layout title={title} description={description} jsonLd={schemas}>
  <main>
    <section class="bg-gradient-to-br from-slate-100 to-teal-50 py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6 md:px-8">
        <nav class="mb-8 text-sm text-slate-600" aria-label="breadcrumb">
          <a href="/">首頁</a><span class="mx-2">／</span>
          <a href="/services/">服務項目</a><span class="mx-2">／</span>
          <span>骨質疏鬆門診</span>
        </nav>
        <div class="max-w-3xl">
          <p class="mb-4 text-sm font-bold tracking-[0.18em] text-teal-700">骨密度只是起點</p>
          <h1 class="mb-6 text-4xl font-extrabold leading-tight text-primary md:text-6xl">骨質疏鬆門診<br/><span class="text-teal-700">把骨折風險看完整</span></h1>
          <p class="mb-8 text-lg leading-relaxed text-slate-700 md:text-xl">由家庭醫學科專科醫師陳昱彰（具中華民國骨質疏鬆症學會認證）整合 DXA 骨密度、骨折病史、次發原因、跌倒風險與目前用藥，協助判斷是否需要進一步檢查、生活調整或治療。</p>
          <a href="https://webreg.edah.org.tw/Register/ChooseDoctorTime/2675" target="_blank" rel="noopener" class="inline-block rounded-full bg-blue-950 px-7 py-3.5 font-bold text-white no-underline">義大線上掛號</a>
          <p class="mt-5 text-sm leading-relaxed text-slate-600">本頁為服務與衛教資訊，不取代個別診療；實際檢查與治療須依醫師評估。</p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-24">
      <div class="grid gap-12 md:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="mb-3 text-sm font-bold tracking-widest text-teal-700">何時可以評估</p>
          <h2 class="mb-6 text-3xl font-bold text-primary">不只停經後女性需要注意</h2>
          <p class="mb-6 text-on-surface-variant chinese-line-height">若有以下情況，可和醫師討論是否需要骨密度或完整骨折風險評估：</p>
          <ul class="space-y-3 text-on-surface-variant">
            <li class="rounded-2xl bg-surface-container-low p-4">曾因輕微跌倒或日常動作發生骨折</li>
            <li class="rounded-2xl bg-surface-container-low p-4">已停經、年齡增加，或有明顯骨鬆風險因子</li>
            <li class="rounded-2xl bg-surface-container-low p-4">長期使用類固醇或其他可能影響骨骼的藥物</li>
            <li class="rounded-2xl bg-surface-container-low p-4">體重過輕、反覆跌倒，或有父母髖部骨折史</li>
            <li class="rounded-2xl bg-surface-container-low p-4">有甲狀腺、副甲狀腺、性腺、吸收不良或其他相關疾病</li>
          </ul>
        </div>
        <div class="rounded-3xl bg-blue-950 p-7 text-white md:p-10">
          <h2 class="mb-6 text-3xl font-bold">門診會一起看什麼？</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl bg-white/10 p-5"><strong class="block text-teal-200">骨密度</strong><span class="mt-2 block text-sm text-blue-100">正確理解 T-score、Z-score 與檢查部位</span></div>
            <div class="rounded-2xl bg-white/10 p-5"><strong class="block text-teal-200">骨折風險</strong><span class="mt-2 block text-sm text-blue-100">整合既往骨折、跌倒、家族史與生活因素</span></div>
            <div class="rounded-2xl bg-white/10 p-5"><strong class="block text-teal-200">次發原因</strong><span class="mt-2 block text-sm text-blue-100">依需要評估疾病、營養與藥物影響</span></div>
            <div class="rounded-2xl bg-white/10 p-5"><strong class="block text-teal-200">治療策略</strong><span class="mt-2 block text-sm text-blue-100">討論運動、鈣與維生素 D、跌倒預防及藥物</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-surface-container-low py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6 md:px-8">
        <p class="mb-3 text-sm font-bold tracking-widest text-teal-700">從檢查到追蹤</p>
        <h2 class="mb-10 text-3xl font-bold text-primary">四個步驟做完整判斷</h2>
        <ol class="grid gap-5 md:grid-cols-4">
          <li class="rounded-3xl bg-white p-6"><span class="mb-3 block text-sm font-bold text-teal-700">01</span><strong class="block text-lg text-primary">了解病史</strong><span class="mt-2 block text-sm text-on-surface-variant">骨折、跌倒、家族史、疾病與藥物</span></li>
          <li class="rounded-3xl bg-white p-6"><span class="mb-3 block text-sm font-bold text-teal-700">02</span><strong class="block text-lg text-primary">解讀檢查</strong><span class="mt-2 block text-sm text-on-surface-variant">DXA 與既有影像，不只看單一數字</span></li>
          <li class="rounded-3xl bg-white p-6"><span class="mb-3 block text-sm font-bold text-teal-700">03</span><strong class="block text-lg text-primary">排除原因</strong><span class="mt-2 block text-sm text-on-surface-variant">依情況安排必要而非制式的檢查</span></li>
          <li class="rounded-3xl bg-white p-6"><span class="mb-3 block text-sm font-bold text-teal-700">04</span><strong class="block text-lg text-primary">共同決策</strong><span class="mt-2 block text-sm text-on-surface-variant">選擇適合的預防、治療與追蹤方式</span></li>
        </ol>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-24">
      <div class="grid gap-6 md:grid-cols-2">
        <a href="/blog/osteoporosis-screening-guide/" class="rounded-3xl border border-outline-variant/30 p-7 no-underline">
          <p class="mb-2 text-sm font-bold text-teal-700">延伸閱讀</p>
          <h2 class="mb-3 text-2xl font-bold text-primary">誰該做骨密度？DXA 完整指南</h2>
          <p class="text-on-surface-variant chinese-line-height">了解 T-score、Z-score、常見風險因子與檢查前後的重點。</p>
        </a>
        <a href="/blog/sarcopenia-resistance-training/" class="rounded-3xl border border-outline-variant/30 p-7 no-underline">
          <p class="mb-2 text-sm font-bold text-teal-700">延伸閱讀</p>
          <h2 class="mb-3 text-2xl font-bold text-primary">肌少症與阻力訓練</h2>
          <p class="text-on-surface-variant chinese-line-height">骨骼與肌肉要一起照顧，降低跌倒並維持日常功能。</p>
        </a>
      </div>
    </section>

    <section class="bg-blue-950 py-16">
      <div class="mx-auto max-w-3xl px-6">
        <h2 class="mb-8 text-center text-3xl font-bold text-white">常見問題</h2>
        <div class="space-y-4">
          {faqs.map((item) => (
            <details class="rounded-2xl bg-white p-6">
              <summary class="cursor-pointer font-bold text-primary">{item.q}</summary>
              <p class="mt-4 text-on-surface-variant chinese-line-height">{item.a}</p>
            </details>
          ))}
        </div>
        <div class="mt-10 text-center">
          <a href="https://webreg.edah.org.tw/Register/ChooseDoctorTime/2675" target="_blank" rel="noopener" class="inline-block rounded-full bg-teal-700 px-8 py-3.5 font-bold text-white no-underline">預約義大門診</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
