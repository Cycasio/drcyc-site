---
import Layout from '../layouts/Layout.astro';
import { publications, publicationSchemas } from '../data/publications';

const SITE = 'https://www.drcyc.io';
const title = '學術論文與研究｜陳昱彰醫師 Yu-Chang Chen';
const description = '陳昱彰醫師的同行審查期刊論文、完整作者順序、研究摘要、DOI 與 PubMed 紀錄，資料依出版社正式版本整理。';

const pageSchema = {
  '@type': 'CollectionPage',
  '@id': `${SITE}/publications/#webpage`,
  url: `${SITE}/publications/`,
  name: title,
  description,
  inLanguage: 'zh-Hant',
  datePublished: '2026-09-02',
  dateModified: '2026-09-02',
  isPartOf: { '@id': `${SITE}/#website` },
  about: { '@id': `${SITE}/#person` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: publications.length,
    itemListElement: publications.map((publication, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: { '@id': `https://doi.org/${publication.doi}` },
    })),
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: '關於', item: `${SITE}/about/` },
      { '@type': 'ListItem', position: 3, name: '學術論文與研究', item: `${SITE}/publications/` },
    ],
  },
};
---

<Layout title={title} description={description} jsonLd={[pageSchema, ...publicationSchemas]}>
  <main>
    <section class="bg-gradient-to-br from-slate-100 via-white to-teal-50 py-16 md:py-24">
      <div class="mx-auto max-w-5xl px-6 md:px-8">
        <nav class="mb-8 text-sm text-slate-600" aria-label="breadcrumb">
          <a href="/" class="hover:text-primary">首頁</a>
          <span class="mx-2">／</span>
          <a href="/about/" class="hover:text-primary">關於</a>
          <span class="mx-2">／</span>
          <span>學術論文與研究</span>
        </nav>

        <div class="max-w-3xl">
          <p class="mb-4 text-sm font-bold tracking-[0.18em] text-teal-700">PUBLICATIONS</p>
          <h1 class="mb-6 text-4xl font-extrabold leading-tight text-blue-950 md:text-6xl">
            學術論文與研究
          </h1>
          <p class="text-lg leading-relaxed text-slate-700 md:text-xl">
            本頁列出陳昱彰醫師已發表、可由出版社與 PubMed 核實的同行審查期刊論文。作者順序、發表日期、DOI 與 PMID 均依正式出版紀錄整理。
          </p>
          <div class="mt-8 flex flex-wrap gap-3 text-sm">
            <a href="https://orcid.org/0009-0005-2506-1058" target="_blank" rel="noopener" class="rounded-full border border-blue-950/20 bg-white px-5 py-2.5 font-bold text-blue-950 no-underline hover:border-teal-700">ORCID 0009-0005-2506-1058</a>
            <a href="https://pubmed.ncbi.nlm.nih.gov/?term=Chen+Yu-Chang+E-Da" target="_blank" rel="noopener" class="rounded-full border border-blue-950/20 bg-white px-5 py-2.5 font-bold text-blue-950 no-underline hover:border-teal-700">PubMed 作者搜尋</a>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6 py-16 md:px-8 md:py-24" aria-labelledby="peer-reviewed-heading">
      <div class="mb-10 max-w-3xl">
        <p class="mb-3 text-sm font-bold tracking-widest text-teal-700">PEER-REVIEWED ARTICLES</p>
        <h2 id="peer-reviewed-heading" class="mb-4 text-3xl font-bold text-blue-950">同行審查期刊論文</h2>
        <p class="leading-relaxed text-slate-600">研究摘要旨在幫助讀者快速理解研究問題、方法與限制；引用時仍應以出版社的正式版本為準。</p>
      </div>

      <div class="space-y-10">
        {publications.map((publication, index) => (
          <article id={publication.id} class="scroll-mt-24 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm" aria-labelledby={`${publication.id}-title`}>
            <div class="border-b border-slate-100 bg-surface-container-low p-6 md:p-8">
              <div class="mb-5 flex flex-wrap gap-2 text-xs font-bold">
                <span class="rounded-full bg-blue-950 px-3 py-1.5 text-white">{publication.publishedDate.slice(0, 4)}</span>
                <span class="rounded-full bg-teal-100 px-3 py-1.5 text-teal-800">{publication.studyType}</span>
                <span class="rounded-full bg-amber-100 px-3 py-1.5 text-amber-900">出版社註記：貢獻相同</span>
              </div>
              <p class="mb-3 text-sm font-bold text-teal-700">{index + 1}. {publication.journal}</p>
              <h3 id={`${publication.id}-title`} class="text-2xl font-extrabold leading-snug text-blue-950 md:text-3xl" lang="en">
                {publication.title}
              </h3>
              <p class="mt-5 text-sm leading-relaxed text-slate-700">
                {publication.authors.map((author, authorIndex) => (
                  <>
                    <span class:list={[author === 'Yu Chang Chen' && 'font-extrabold text-blue-950']}>
                      <span lang="en">{author}</span>{author === 'Yu Chang Chen' ? '（陳昱彰）' : ''}
                    </span>
                    {authorIndex < publication.authors.length - 1 ? ', ' : ''}
                  </>
                ))}
              </p>
              <p class="mt-3 text-sm text-slate-600">
                {publication.journal}，第 {publication.volume} 卷，文章編號 {publication.articleNumber}；發表於 {publication.publishedDateLabel}。
              </p>
            </div>

            <div class="p-6 md:p-8">
              <div class="grid gap-5 md:grid-cols-2">
                <div class="rounded-2xl bg-slate-50 p-5">
                  <h4 class="mb-2 font-bold text-blue-950">研究問題</h4>
                  <p class="text-sm leading-relaxed text-slate-700">{publication.researchQuestion}</p>
                </div>
                <div class="rounded-2xl bg-slate-50 p-5">
                  <h4 class="mb-2 font-bold text-blue-950">資料與方法</h4>
                  <p class="text-sm leading-relaxed text-slate-700">{publication.methods}</p>
                </div>
                <div class="rounded-2xl bg-teal-50 p-5 md:col-span-2">
                  <h4 class="mb-2 font-bold text-teal-900">主要發現</h4>
                  <p class="text-sm leading-relaxed text-slate-700">{publication.keyFinding}</p>
                  <p class="mt-3 border-t border-teal-200 pt-3 text-xs leading-relaxed text-slate-600">解讀提醒：{publication.interpretationNote}</p>
                </div>
              </div>

              <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-5">
                <h4 class="mb-2 font-bold text-amber-950">出版社記載的作者資訊</h4>
                <p class="text-sm leading-relaxed text-slate-700">{publication.equalContributionNote}</p>
                <p class="mt-2 text-sm leading-relaxed text-slate-700">{publication.verifiedContribution}</p>
              </div>

              <div class="mt-6 rounded-2xl border border-slate-200 p-5">
                <h4 class="mb-2 font-bold text-blue-950">正式引用</h4>
                <p class="text-sm leading-relaxed text-slate-700" lang="en">{publication.citation}</p>
                <p class="mt-2 text-xs text-slate-500">DOI：{publication.doi}　·　PMID：{publication.pubmed}</p>
              </div>

              <div class="mt-6 flex flex-wrap gap-3">
                <a href={publication.publisherUrl} target="_blank" rel="noopener" class="rounded-full bg-blue-950 px-5 py-2.5 text-sm font-bold text-white no-underline hover:opacity-90">出版社全文</a>
                <a href={`https://pubmed.ncbi.nlm.nih.gov/${publication.pubmed}/`} target="_blank" rel="noopener" class="rounded-full border border-blue-950/20 px-5 py-2.5 text-sm font-bold text-blue-950 no-underline hover:border-teal-700">PubMed 紀錄</a>
                <a href={`https://doi.org/${publication.doi}`} target="_blank" rel="noopener" class="rounded-full border border-blue-950/20 px-5 py-2.5 text-sm font-bold text-blue-950 no-underline hover:border-teal-700">DOI 永久連結</a>
                {publication.id === 'sarcopenia-resistance-training' && (
                  <a href="/blog/sarcopenia-resistance-training/" class="rounded-full border border-teal-700/30 px-5 py-2.5 text-sm font-bold text-teal-800 no-underline hover:bg-teal-50">閱讀肌少症衛教</a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-blue-950 py-16">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <h2 class="mb-4 text-3xl font-bold text-white">研究資料如何整理</h2>
        <p class="mx-auto max-w-2xl leading-relaxed text-blue-100">
          本頁只列入已有正式 DOI 與 PubMed 紀錄的期刊論文；不把投稿中、尚未接受或無法核實的內容列為已發表成果。若出版社後續更新版本，以正式出版頁為準。
        </p>
        <a href="/about/" class="mt-8 inline-block rounded-full bg-white px-7 py-3 font-bold text-blue-950 no-underline hover:opacity-90">返回關於陳昱彰醫師</a>
      </div>
    </section>
  </main>
</Layout>
