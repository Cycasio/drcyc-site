---
import Layout from '../layouts/Layout.astro';
import { publications, publicationSchemas } from '../data/publications';

const SITE = 'https://www.drcyc.io';

const aboutPageSchema = {
  '@type': 'ProfilePage',
  '@id': `${SITE}/about/#profilepage`,
  url: `${SITE}/about/`,
  name: '關於陳昱彰醫師',
  description: '陳昱彰醫師的現職、專科資格、訓練身分、學歷與學術發表。',
  dateModified: '2026-09-02T00:00:00+08:00',
  isPartOf: { '@id': `${SITE}/#website` },
  mainEntity: { '@id': `${SITE}/#person` },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: '關於', item: `${SITE}/about/` },
    ],
  },
};

const title = '關於陳昱彰醫師｜義大醫院家醫科・肥胖與骨鬆學會認證・實證銀獎';
const description =
  '陳昱彰醫師：義大醫院家庭暨社區醫學部主治醫師，具家庭醫學科專科醫師資格及肥胖、骨鬆學會認證。現為職業醫學科訓練醫師（尚未取得該科專科醫師資格），並具勞工健康服務醫師資格與 ACE-CPT 認證。榮獲國家醫療品質獎實證醫學類臨床組銀獎，發表 SCI 期刊論文 2 篇。';

const credentials = [
  { category: '現職與訓練', items: [
    '義大醫院 家庭暨社區醫學部主治醫師',
    '義大醫院 減重中心醫師',
    '職業醫學科訓練醫師（尚未取得職業醫學科專科醫師資格）',
  ]},
  { category: '專科醫師證書', items: [
    '家庭醫學科專科醫師',
  ]},
  { category: '資格與認證', items: [
    '台灣肥胖醫學會認證醫師',
    '中華民國骨質疏鬆症學會認證醫師',
    '勞工健康服務醫師資格',
    '糖尿病共同照護網醫事人員',
    '戒菸治療認證醫師',
    'OSCE 國家考試考官',
    'ACE-CPT 美國運動委員會認證私人教練',
  ]},
  { category: '學歷', items: [
    '高雄醫學大學 醫學系',
    '曾於國立臺灣大學公共衛生碩士學位學程（MPH）健康行為與社區科學組進修，修畢課程',
    '義守大學 生物技術與化學工程研究所博士班（就讀中）',
  ]},
  { category: '榮譽', items: [
    '國家醫療品質獎 實證醫學類 臨床組 銀獎',
    '國家醫療品質獎 實證醫學類 新人組 佳作',
    '醫策會 EBM 競賽 臨床組 佳作',
    '義大醫院 模範住院醫師',
  ]},
];

---

<Layout title={title} description={description} jsonLd={[aboutPageSchema, ...publicationSchemas]}>
  <main class="max-w-4xl mx-auto px-6 md:px-12 py-16">
    <nav class="text-sm text-outline mb-8" aria-label="breadcrumb">
      <a href="/" class="hover:text-primary">首頁</a>
      <span class="mx-2">／</span>
      <span>關於</span>
    </nav>

    <header class="mb-12 grid gap-8 md:grid-cols-[1fr_180px] md:items-center">
      <div>
        <p class="text-sm font-bold tracking-widest text-teal-700 uppercase mb-4">About</p>
        <h1 class="text-4xl md:text-5xl font-extrabold text-blue-950 leading-tight mb-6">
          陳昱彰 醫師<br/>
          <span class="text-2xl md:text-3xl text-slate-600 font-bold">Yu-Chang Chen, MD</span>
        </h1>
        <p class="text-lg text-slate-700 chinese-line-height max-w-3xl">
          義大醫院家庭暨社區醫學部主治醫師與減重中心醫師。現為<strong>職業醫學科訓練醫師</strong>，具勞工健康服務醫師資格；尚未取得職業醫學科專科醫師資格。整合家庭醫學、肥胖醫學、骨質疏鬆、運動處方與職場健康，
          以 <strong>COM-B 行為改變模型</strong>與<strong>實證醫學</strong>為雙核心，協助民眾建立能長期維持的健康習慣，
          而非只靠藥物與意志力。
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/services/" class="rounded-full bg-blue-950 px-5 py-2.5 text-sm font-bold text-white no-underline">檢視服務</a>
          <a href="https://webreg.edah.org.tw/Register/ChooseDoctorTime/2675" target="_blank" rel="noopener" class="rounded-full border border-blue-950/20 px-5 py-2.5 text-sm font-bold text-blue-950 no-underline">義大線上掛號</a>
        </div>
      </div>
      <img
        src="/images/portrait.jpg"
        alt="陳昱彰醫師"
        width="180"
        height="225"
        class="mx-auto aspect-[4/5] w-40 rounded-3xl object-cover shadow-lg md:w-[180px]"
      />
    </header>

    <section class="mb-16 rounded-3xl bg-surface-container-low p-6 md:p-8">
      <h2 class="text-2xl font-bold text-blue-950 mb-6">現職、學歷與專業資格</h2>
      <div class="grid md:grid-cols-2 gap-8">
        {credentials.map(({category, items}) => (
          <div>
            <h3 class="text-sm font-bold tracking-widest text-teal-700 uppercase mb-4">{category}</h3>
            <ul class="space-y-2 text-slate-700 text-sm leading-relaxed">
              {items.map(item => <li>• {item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-bold text-blue-950 mb-6">臨床理念</h2>
      <blockquote class="border-l-4 border-teal-600 pl-6 py-2 text-xl text-blue-950 font-bold leading-relaxed">
        「醫學的價值，不僅在於治療疾病，更在於幫助人們過上更好的生活。」
      </blockquote>
      <p class="mt-6 text-slate-700 chinese-line-height">
        陳醫師的臨床模型：<strong>理解（Understand）→ 溝通（Communicate）→ 改變（Transform）</strong>。
        先花時間理解病患的生活脈絡與動機，再以動機式晤談建立信任，最後以行為科學工具協助實際改變。
        這套方法在減重、戒菸、慢性病管理與職場健康上都能應用。
      </p>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-bold text-blue-950 mb-6">認識診間外的我</h2>
      <p class="text-slate-700 chinese-line-height mb-4">
        很多人看到我的興趣清單會愣一下：一個家醫科醫師，怎麼會彈烏克麗麗、下圍棋拿過大專盃甲組（業餘一段）、
        國中就自學 PHP／MySQL 架網站當論壇版主，還練過雙節棍、國術與搏擊，假日往山裡跑？
      </p>
      <p class="text-slate-700 chinese-line-height mb-6">
        但這些其實都指向同一件事——<strong>我喜歡把複雜的東西拆解開來，再重新組裝成「人真的用得上」的樣子。</strong>
        這也是我看病的方式。
      </p>
      <div class="grid sm:grid-cols-2 gap-4 mb-6">
        <div class="rounded-2xl bg-surface-container-low p-5">
          <div class="text-2xl mb-2">♟️</div>
          <h3 class="font-bold text-blue-950 mb-1">圍棋・象棋</h3>
          <p class="text-sm text-slate-600 chinese-line-height">教我看大局、算後手。所以我看三高、代謝不會頭痛醫頭，而是把整盤棋一起下。</p>
        </div>
        <div class="rounded-2xl bg-surface-container-low p-5">
          <div class="text-2xl mb-2">💻</div>
          <h3 class="font-bold text-blue-950 mb-1">國中自學寫程式、架論壇</h3>
          <p class="text-sm text-slate-600 chinese-line-height">從小愛把系統拆開研究。所以我後來做了一整套線上健康計算機，也投入 LINE Bot 減重管理研究——把衛教變成你手邊的工具。</p>
        </div>
        <div class="rounded-2xl bg-surface-container-low p-5">
          <div class="text-2xl mb-2">🥋</div>
          <h3 class="font-bold text-blue-950 mb-1">國術・搏擊・登山跑山</h3>
          <p class="text-sm text-slate-600 chinese-line-height">我是真心相信「運動是藥」的人，所以取得 ACE-CPT 認證，能幫你規劃較貼近日常、能逐步調整的運動處方，而不是一句「多運動」。</p>
        </div>
        <div class="rounded-2xl bg-surface-container-low p-5">
          <div class="text-2xl mb-2">🎶</div>
          <h3 class="font-bold text-blue-950 mb-1">烏克麗麗・音樂</h3>
          <p class="text-sm text-slate-600 chinese-line-height">在高雄烏克麗麗玩樂團。它提醒我：顧健康是為了好好生活，不是把日子過得緊繃。衛教也可以是輕鬆的。</p>
        </div>
      </div>
      <p class="text-slate-700 chinese-line-height">
        所以「行為設計學」（COM-B、BJ Fogg 行為模型、動機式晤談）對我不是課本上的理論，而是我一直在做的事：
        <strong>理解一個系統怎麼運作，再設計出讓改變自然發生的方法。</strong>放到減重、戒菸、慢性病上，就是我的看診方式。
      </p>
    </section>

    <section class="mb-16">
      <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-2xl font-bold text-blue-950">學術發表</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">以下論文均可由出版社正式版本與 PubMed 紀錄核實。</p>
        </div>
        <a href="/publications/" class="text-sm font-bold text-teal-700 underline underline-offset-4">檢視完整作者、研究摘要與貢獻紀錄 →</a>
      </div>
      <h3 class="text-sm font-bold tracking-widest text-teal-700 uppercase mb-4">SCI 期刊論文</h3>
      <ol class="space-y-6 mb-10">
        {publications.map((p, i) => (
          <li class="pl-6 border-l-2 border-slate-200">
            <p class="text-slate-700 text-sm leading-relaxed">{p.citation}</p>
            <p class="text-xs text-outline mt-1">
              DOI: <a class="text-teal-700 underline" href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener">{p.doi}</a>
              {' · '}
              PMID: <a class="text-teal-700 underline" href={`https://pubmed.ncbi.nlm.nih.gov/${p.pubmed}/`} target="_blank" rel="noopener">{p.pubmed}</a>
            </p>
          </li>
        ))}
      </ol>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-bold text-blue-950 mb-6">聯絡與學術身份</h2>
      <dl class="grid md:grid-cols-2 gap-4 text-sm">
        <div><dt class="font-bold text-blue-950">門診單位</dt><dd class="text-slate-700">義大醫院 家庭暨社區醫學部</dd></div>
        <div><dt class="font-bold text-blue-950">線上掛號</dt><dd><a class="text-teal-700 underline" href="https://webreg.edah.org.tw/Register/ChooseDoctorTime/2675" target="_blank" rel="noopener">義大醫院預約系統</a></dd></div>
        <div><dt class="font-bold text-blue-950">Email</dt><dd><!--email_off--><a class="text-teal-700 underline" href="mailto:cyc@edfm.org">cyc@edfm.org</a><!--/email_off--></dd></div>
        <div><dt class="font-bold text-blue-950">Facebook</dt><dd><a class="text-teal-700 underline" href="https://www.facebook.com/lazydr" target="_blank" rel="noopener">@lazydr</a></dd></div>
        <div><dt class="font-bold text-blue-950">Instagram</dt><dd><a class="text-teal-700 underline" href="https://www.instagram.com/lazydr.cyc" target="_blank" rel="noopener">@lazydr.cyc</a></dd></div>
        <div><dt class="font-bold text-blue-950">ORCID</dt><dd><a class="text-teal-700 underline" href="https://orcid.org/0009-0005-2506-1058" target="_blank" rel="noopener">0009-0005-2506-1058</a></dd></div>
        <div><dt class="font-bold text-blue-950">PubMed</dt><dd><a class="text-teal-700 underline" href="https://pubmed.ncbi.nlm.nih.gov/?term=Chen+Yu-Chang+E-Da" target="_blank" rel="noopener">作者文章搜尋 →</a></dd></div>
        <div><dt class="font-bold text-blue-950">Google Scholar</dt><dd><a class="text-teal-700 underline" href="https://scholar.google.com/scholar?q=Chen+Yu-Chang+sarcopenia+E-Da" target="_blank" rel="noopener">學術文章搜尋 →</a></dd></div>
      </dl>
    </section>

    <section class="p-10 bg-gradient-to-br from-blue-950 to-teal-700 rounded-2xl text-white text-center">
      <h3 class="text-2xl font-bold mb-4">準備好開始您的健康旅程</h3>
      <a
        href="https://webreg.edah.org.tw/Register/ChooseDoctorTime/2675"
        target="_blank"
        rel="noopener"
        class="inline-block bg-white text-blue-950 px-8 py-3 rounded-full font-bold hover:opacity-90 no-underline"
      >
        立即線上掛號
      </a>
    </section>
  </main>
</Layout>
