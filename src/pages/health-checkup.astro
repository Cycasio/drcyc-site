---
import Layout from '../layouts/Layout.astro';
import {
  PACKAGES,
  EVIDENCE,
  LOW_EVIDENCE_NOTE,
  GENERAL_PREP,
  ENDO_PREP,
  BOWEL_PREP_CHECKLIST,
  BOWEL_PREP_SOURCE_URL,
  PACKAGE_COUNT,
  SCREENING_LAST_CHECKED,
  TAIWAN_SCREENING,
  HPA_SCREENING_URL,
  LOCATION,
  TRANSIT_CAR,
  TRANSIT_PUBLIC,
  FAQ,
  PACKAGE_LAST_CHECKED,
  PACKAGE_PRICE_LAST_CHECKED,
  HOSPITAL_URL,
  OFFICIAL_PACKAGES_URL,
  PUBLIC_EMPLOYEE_PDF_SOURCES,
  PREMIUM_PRICE_SOURCES,
  BOOKING_PHONE,
  BOOKING_EXTENSIONS,
} from '../data/checkup';

const SITE = 'https://www.drcyc.io';
const pageUrl = `${SITE}/health-checkup/`;
// 頁面內容更新與套餐、USPSTF 資料核對日期分開，避免暗示全部資訊均重新查核。
const PAGE_UPDATED = '2026-09-21';

const publicPackages = PACKAGES.filter((p) => p.group === '公教人員專案');
const premiumPackages = PACKAGES.filter((p) => p.group === '健診中心精選');

const fmtPrice = (n: number) => `$${n.toLocaleString('en-US')}`;

const medicalWebPage = {
  '@type': 'MedicalWebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: '義大醫院健檢指南 2026｜公費篩檢與套餐比較',
  description:
    `義大醫院家醫科陳昱彰醫師整理 ${PACKAGE_COUNT} 個參考健檢方案，分開說明台灣公費篩檢、USPSTF 建議與自費套餐，附核對日期及準備提醒。`,
  datePublished: '2026-04-13',
  dateModified: PAGE_UPDATED,
  author: { '@id': `${SITE}/#person` },
  publisher: { '@id': `${SITE}/#person` },
  about: { '@type': 'MedicalProcedure', name: '健康檢查 Health Checkup' },
  specialty: 'https://schema.org/PrimaryCare',
  inLanguage: 'zh-Hant',
};

// USPSTF 評等專有名詞（DefinedTermSet）— 讓 AI 理解這些是專業術語
const uspstfTermSet = {
  '@type': 'DefinedTermSet',
  '@id': `${pageUrl}#uspstf-grades`,
  name: 'USPSTF 預防服務工作小組建議等級',
  sameAs: 'https://www.uspreventiveservicestaskforce.org/uspstf/grade-definitions',
  hasDefinedTerm: [
    {
      '@type': 'DefinedTerm',
      '@id': `${pageUrl}#uspstf-grade-a`,
      name: 'Grade A',
      description: 'USPSTF 強烈建議該預防服務。有高度確信淨效益顯著。',
      termCode: 'A',
      inDefinedTermSet: { '@id': `${pageUrl}#uspstf-grades` },
    },
    {
      '@type': 'DefinedTerm',
      '@id': `${pageUrl}#uspstf-grade-b`,
      name: 'Grade B',
      description: 'USPSTF 建議該預防服務。有高度確信淨效益中等,或中度確信淨效益顯著。',
      termCode: 'B',
      inDefinedTermSet: { '@id': `${pageUrl}#uspstf-grades` },
    },
    {
      '@type': 'DefinedTerm',
      '@id': `${pageUrl}#uspstf-grade-c`,
      name: 'Grade C',
      description: 'USPSTF 建議僅在個別情況下進行,根據專業判斷與病人偏好決定。淨效益小。',
      termCode: 'C',
      inDefinedTermSet: { '@id': `${pageUrl}#uspstf-grades` },
    },
    {
      '@type': 'DefinedTerm',
      '@id': `${pageUrl}#uspstf-grade-d`,
      name: 'Grade D',
      description: 'USPSTF 不建議該預防服務。有中度或高度確信此服務無淨效益,或可能造成傷害。',
      termCode: 'D',
      inDefinedTermSet: { '@id': `${pageUrl}#uspstf-grades` },
    },
    {
      '@type': 'DefinedTerm',
      '@id': `${pageUrl}#uspstf-grade-i`,
      name: 'I Statement',
      description: 'USPSTF 認為目前證據不足以評估該預防服務的利弊平衡。',
      termCode: 'I',
      inDefinedTermSet: { '@id': `${pageUrl}#uspstf-grades` },
    },
  ],
};

const itemListSchema = {
  '@type': 'ItemList',
  '@id': `${pageUrl}#packagelist`,
  name: '義大醫院健診中心套餐',
  numberOfItems: PACKAGES.length,
  itemListElement: PACKAGES.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${p.name}（${p.theme}）`,
    url: `${pageUrl}#pkg-${p.id}`,
    item: {
      '@type': ['MedicalProcedure', 'Service'],
      '@id': `${pageUrl}#pkg-${p.id}-procedure`,
      name: p.name,
      // 把陳醫師的實證點評併入 description(不再用 Review 型別:Review 須由第三方評、
      // 且 MedicalProcedure 不在 Google 評論富結果支援的父型別清單裡,自評用 Review 語意也錯)
      description: `${p.theme}。${p.chenNote}`,
      url: `${pageUrl}#pkg-${p.id}`,
      serviceType: '健康檢查 Health Checkup',
      provider: {
        '@type': 'Hospital',
        name: '義大醫院',
        url: HOSPITAL_URL,
      },
      offers: {
        '@type': 'Offer',
        price: p.price.toString(),
        priceCurrency: 'TWD',
        seller: {
          '@type': 'Hospital',
          name: '義大醫院',
          url: HOSPITAL_URL,
        },
        url: `${pageUrl}#pkg-${p.id}`,
      },
    },
  })),
};

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: '義大健檢指南', item: pageUrl },
  ],
};

const title = '義大醫院健檢指南 2026｜公費篩檢與套餐比較｜陳昱彰醫師';
const description =
  `陳昱彰醫師整理義大醫院 ${PACKAGE_COUNT} 個參考健檢方案，先看台灣公費篩檢，再對照 USPSTF 建議與個人風險。公開標價核對日 ${PACKAGE_PRICE_LAST_CHECKED}，實際價格、內容及供應請向健診中心確認。`;
---

<Layout
  title={title}
  description={description}
  jsonLd={[medicalWebPage, uspstfTermSet, itemListSchema, faqSchema, breadcrumbSchema]}
>
  <main class="max-w-6xl mx-auto px-6 md:px-10 py-12">
    <!-- Breadcrumb -->
    <nav class="text-xs text-slate-500 mb-6" aria-label="breadcrumb">
      <a href="/" class="hover:text-teal-700">首頁</a>
      <span class="mx-2">／</span>
      <span>義大健檢指南</span>
    </nav>

    <!-- Hero -->
    <header class="mb-10">
      <p class="text-xs font-bold tracking-widest text-teal-700 uppercase mb-3">
        Health Checkup Guide · 2025–2026
      </p>
      <h1 class="text-3xl md:text-5xl font-extrabold text-blue-950 leading-tight mb-5">
        義大醫院健檢指南
      </h1>
      <p class="text-lg text-slate-700 leading-relaxed max-w-3xl chinese-line-height">
        我是義大醫院家醫科主治醫師<strong>陳昱彰</strong>。這一頁把義大健診中心 2025–2026
        年度的 <strong>{PACKAGE_COUNT} 個參考方案</strong>放在一起比較。
        先確認<strong>台灣公費篩檢</strong>，再看符合個人風險的建議，最後才決定是否加選自費檢查。
      </p>
    </header>

    <nav aria-label="健檢指南章節" class="flex flex-wrap gap-3 mb-8 text-sm">
      {[
        ['#taiwan-screening', '先看公費資格'],
        ['#evidence', '篩檢實證'],
        ['#lpa-apob', 'Lp(a) 與 ApoB'],
        ['#comparison', '比較參考方案'],
        ['#prep', '檢查前準備'],
      ].map(([href, label]) => <a href={href} class="rounded-full border border-teal-200 px-4 py-2 min-h-11 inline-flex items-center text-teal-800 hover:bg-teal-50">{label}</a>)}
    </nav>

    <!-- Disclaimer -->
    <aside class="rounded-xl border-l-4 border-teal-600 bg-teal-50/60 p-5 mb-12 text-sm text-slate-700 leading-relaxed">
      <p class="mb-2">
        <strong class="text-teal-800">資料來源聲明</strong> —
        <strong>15 個方案的官方公開標價核對日：{PACKAGE_PRICE_LAST_CHECKED}</strong>。
        公費資格與篩檢建議核對日：{SCREENING_LAST_CHECKED}；整份套餐內容前次核對日：{PACKAGE_LAST_CHECKED}。
        本次另修正公教 B、C、E、F、G 方案的部分項目，不代表全部套餐內容已重新核對。
        實際價格、檢查項目、適用身分與是否仍供應，請於預約時向健診中心確認。
      </p>
      <details class="mb-3">
        <summary class="cursor-pointer text-teal-800 font-semibold py-2">檢視官方套餐與標價來源</summary>
        <p class="mt-2">
        <a href={OFFICIAL_PACKAGES_URL} target="_blank" rel="noopener" class="text-teal-700 underline"
          >義大健診中心套餐總頁</a
        >；公教 PDF 與精選套餐下列型錄頁可核對本表價格，其他項目請看完整型錄。
        </p>
        <ul class="list-disc pl-5 mt-2 space-y-2">
          {[...PUBLIC_EMPLOYEE_PDF_SOURCES, ...PREMIUM_PRICE_SOURCES].map((source) => (
            <li><a href={source.url} target="_blank" rel="noopener noreferrer" class="text-teal-700 underline">{source.label}</a></li>
          ))}
        </ul>
      </details>
      <p>
        本文由義大家庭暨社區醫學部陳昱彰醫師整理,<strong>不收取任何轉介佣金</strong
        >,亦非任何形式的廣告文宣。撰寫目的是協助民眾在有實證醫學觀點下選擇適合自己的健檢方案。
      </p>
    </aside>

    <!-- 3-step how-to -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-blue-950 mb-6">三步驟選對你的健檢方案</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="rounded-xl border border-slate-200 bg-white p-5">
          <div class="text-3xl font-extrabold text-teal-700 mb-2">1</div>
          <h3 class="font-bold text-blue-950 mb-1">看風險與公費資格</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            先盤點年齡、吸菸史、家族病史、慢性病與已做過的檢查，再確認公費資格。
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5">
          <div class="text-3xl font-extrabold text-teal-700 mb-2">2</div>
          <h3 class="font-bold text-blue-950 mb-1">對照套餐 + 點評</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            逐項比較需求與限制。整套包含某項檢查，不代表每個人都受益，也不代表整套具有同一實證等級。
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5">
          <div class="text-3xl font-extrabold text-teal-700 mb-2">3</div>
          <h3 class="font-bold text-blue-950 mb-1">確認預約與報告解說</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            致電 {BOOKING_PHONE} 分機 {BOOKING_EXTENSIONS.join(' / ')},可詢問由陳醫師解說報告的安排。
          </p>
        </div>
      </div>
    </section>

    <section id="taiwan-screening" class="scroll-mt-24 mb-14" aria-labelledby="taiwan-screening-title">
      <p class="text-xs font-bold text-teal-700 mb-2">先確認公費，不必直接升級套餐</p>
      <h2 id="taiwan-screening-title" class="text-2xl font-bold text-blue-950 mb-4">台灣公費篩檢：這三項先看資格</h2>
      <div class="grid md:grid-cols-3 gap-4">
        {TAIWAN_SCREENING.map((item) => (
          <article class="rounded-xl border border-teal-200 bg-teal-50/50 p-5">
            <h3 class="font-bold text-blue-950 mb-2">{item.name}</h3>
            <p class="text-sm text-slate-700 leading-relaxed">{item.eligibility}</p>
          </article>
        ))}
      </div>
      <p class="text-sm text-slate-600 mt-4 leading-relaxed">
        公費補助頻率不等於每個人都必須每年檢查。這是部分項目摘要，不是全部公費清單；肺癌、大腸癌等資格與個人篩檢紀錄請一併確認。
        <a href={HPA_SCREENING_URL} class="text-teal-800 underline" target="_blank" rel="noopener noreferrer">檢視國健署完整癌症篩檢資格</a>。
        資格來源核對：{SCREENING_LAST_CHECKED}。
      </p>
    </section>

    <!-- USPSTF Evidence -->
    <section id="evidence" class="scroll-mt-24 mb-14">
      <h2 class="text-2xl font-bold text-blue-950 mb-3">國外指引怎麼看？先確認適用族群</h2>
      <p class="text-slate-700 leading-relaxed mb-4 chinese-line-height">
        以下是美國預防服務工作小組（USPSTF）的正式建議摘要，<strong>不是台灣公費資格，也不是套餐推薦排行榜</strong>。
        A／B 表示對指定族群建議提供；C 為個別選擇；D 為不建議；I 為證據不足。
        有症狀、既往疾病或特殊家族史時，應先接受診斷或個別風險評估。
      </p>
      <p class="text-xs text-slate-500 mb-4">來源核對：{SCREENING_LAST_CHECKED}。每列均附正式原始建議；不使用尚未定案的更新草案。</p>

      <div class="overflow-x-auto rounded-xl border border-slate-200 mb-4">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-blue-950">
            <tr>
              <th class="text-left p-3 font-bold">項目</th>
              <th class="text-center p-3 font-bold w-16">等級</th>
              <th class="text-left p-3 font-bold">建議族群</th>
            </tr>
          </thead>
          <tbody>
            {EVIDENCE.map((e) => (
              <tr class="border-t border-slate-100 align-top">
                <td class="p-3 font-semibold text-blue-950">
                  {e.name}
                  {e.note && <p class="font-normal text-slate-600 text-xs mt-1 leading-relaxed">{e.note}</p>}
                  <a href={e.sourceUrl} class="inline-flex min-h-11 items-center text-xs font-normal text-teal-800 underline" target="_blank" rel="noopener noreferrer" aria-label={`${e.name}：USPSTF 正式建議`}>檢視正式建議 ↗</a>
                </td>
                <td class="p-3 text-center">
                  <span class:list={["inline-block rounded-full font-bold px-3 py-1 text-xs", e.grade === 'D' ? 'bg-rose-100 text-rose-900' : e.grade === 'I' || e.grade === 'C' ? 'bg-slate-100 text-slate-800' : 'bg-teal-100 text-teal-800']}>
                    {e.grade}
                  </span>
                </td>
                <td class="p-3 text-slate-700 leading-relaxed">{e.population}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-500 leading-relaxed chinese-line-height">
        ⚠️ {LOW_EVIDENCE_NOTE}
      </p>
    </section>

    <section id="lpa-apob" class="scroll-mt-24 mb-14 rounded-xl border border-teal-200 bg-teal-50/50 p-6 md:p-8" aria-labelledby="lpa-apob-title">
      <p class="text-xs font-bold tracking-widest text-teal-700 mb-3">心血管風險與健檢加選</p>
      <h2 id="lpa-apob-title" class="text-2xl font-bold text-blue-950 mb-4">需要加驗 Lp(a) 或 ApoB 嗎？</h2>
      <p class="text-slate-700 leading-relaxed mb-4 chinese-line-height">
        膽固醇沒有紅字，不代表心血管風險一定低。2026 年美國血脂指引建議成人至少一生檢測一次
        <strong>Lp(a)</strong>；<strong>ApoB</strong> 則較適合依糖尿病、三酸甘油脂及降血脂治療狀況，評估是否加驗，並非人人每年都需要。
      </p>
      <p class="text-slate-700 leading-relaxed mb-4 chinese-line-height">
        義大健診公開加選表列有 Lp(a) 與 ApoB，但不代表每種套餐都包含。
        表上的<strong>「A 型脂蛋白 Lp(a)」不是 ApoA1</strong>，預約時請確認完整檢驗名稱、費用與採檢準備。
        檢查應依個別風險選擇，不必為了單一抽血項目就升級整套健檢。
      </p>
      <a href="/blog/lpa-apob-health-checkup/" class="inline-flex items-center min-h-11 font-semibold text-teal-800 underline underline-offset-4 hover:text-teal-950">
        閱讀完整衛教：膽固醇正常，還需要驗 Lp(a) 和 ApoB 嗎？
      </a>
      <p class="text-sm text-slate-700 mt-3 leading-relaxed">
        想先整理整體風險，可看
        <a href="/blog/health-tools/cardiovascular-risk-estimator/" class="text-teal-800 underline">10 年與 30 年心血管風險估算工具</a>。
        本站基本模型不使用 Lp(a) 或 ApoB 作為輸入；檢驗結果不能直接加進風險百分比。
      </p>
      <p class="text-xs text-slate-500 mt-3 leading-relaxed">
        本節更新：2026-09-20；加選表核對：2026-09-15；
        <a href="https://exdep.edah.org.tw/hec/index.php/en/2017-07-20-05-36-07/145-2025-12-17-06-43-25" class="underline" target="_blank" rel="noopener noreferrer">義大官方自費加選表</a>。
        此更新不代表其他套餐價格或篩檢指引均已重新核對。
      </p>
    </section>

    <!-- Package Comparison Summary -->
    <section id="comparison" class="mb-14">
      <h2 class="text-2xl font-bold text-blue-950 mb-3">{PACKAGE_COUNT} 個參考方案一次看完</h2>
      <p class="text-sm text-slate-600 mb-6">公教專案 {publicPackages.length} 個＋精選套餐 {premiumPackages.length} 個。下列為 {PACKAGE_PRICE_LAST_CHECKED} 核對的官方公開參考價格，非現行報價；是否仍供應、適用身分及內容請先向健診中心確認。</p>
      <div class="overflow-x-auto rounded-xl border border-slate-200">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-blue-950">
            <tr>
              <th class="text-left p-3 font-bold">套餐</th>
              <th class="text-left p-3 font-bold">主題</th>
              <th class="text-right p-3 font-bold">參考價格</th>
              <th class="text-left p-3 font-bold">時長</th>
            </tr>
          </thead>
          <tbody>
            {PACKAGES.map((p) => (
              <tr class="border-t border-slate-100 hover:bg-slate-50/50">
                <td class="p-3">
                  <a href={`#pkg-${p.id}`} class="font-semibold text-teal-700 hover:underline no-underline">
                    {p.name}
                  </a>
                  <p class="text-xs text-slate-500">{p.group}</p>
                </td>
                <td class="p-3 text-slate-700">{p.theme}</td>
                <td class="p-3 text-right font-mono font-bold text-blue-950 price-tag">{fmtPrice(p.price)}</td>
                <td class="p-3 text-slate-600 text-xs">{p.duration}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Detailed packages: public -->
    <section id="packages-public" class="mb-14">
      <h2 class="text-2xl font-bold text-blue-950 mb-2">公教人員專案 A–H</h2>
      <p class="text-sm text-slate-600 mb-6">$8,900–$18,800（參考價格）｜請確認適用身分及現行內容</p>
      <div class="space-y-6">
        {publicPackages.map((p) => (
          <article id={`pkg-${p.id}`} class="rounded-xl border border-slate-200 bg-white p-6 scroll-mt-24">
            <div class="flex flex-wrap items-start justify-between gap-4 mb-3">
              <div>
                <div class="flex items-center gap-3 mb-1">
                  <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-teal-700 text-white font-bold text-sm">
                    {p.id}
                  </span>
                  <h3 class="text-xl font-bold text-blue-950">{p.name}</h3>
                </div>
                <p class="text-sm text-slate-600">{p.theme}・{p.duration}</p>
              </div>
              <div class="text-right">
                <p class="font-mono font-extrabold text-2xl text-blue-950 price-tag">{fmtPrice(p.price)}</p>
              </div>
            </div>
            <p class="text-sm text-slate-700 mb-4">
              <strong class="text-blue-950">選擇前考量:</strong> {p.bestFor}
            </p>
            <ul class="list-disc list-inside text-sm text-slate-700 space-y-1 mb-4 chinese-line-height">
              {p.highlights.map((h) => <li>{h}</li>)}
            </ul>
            <div class="border-l-4 border-teal-600 bg-teal-50/50 p-4 rounded-r-lg">
              <p class="text-sm text-blue-950 leading-relaxed chinese-line-height">
                <strong>🩺 陳醫師點評:</strong> {p.chenNote}
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Detailed packages: premium -->
    <section id="packages-premium" class="mb-14">
      <h2 class="text-2xl font-bold text-blue-950 mb-2">健診中心精選套餐</h2>
      <p class="text-sm text-slate-600 mb-6">$15,000–$196,000（參考價格）｜項目較多不代表每項都需要</p>
      <div class="space-y-6">
        {premiumPackages.map((p) => (
          <article id={`pkg-${p.id}`} class="rounded-xl border border-slate-200 bg-white p-6 scroll-mt-24">
            <div class="flex flex-wrap items-start justify-between gap-4 mb-3">
              <div>
                <h3 class="text-xl font-bold text-blue-950 mb-1">{p.name}</h3>
                <p class="text-sm text-slate-600">{p.theme}・{p.duration}</p>
              </div>
              <div class="text-right">
                <p class="font-mono font-extrabold text-2xl text-blue-950 price-tag">{fmtPrice(p.price)}</p>
              </div>
            </div>
            <p class="text-sm text-slate-700 mb-4">
              <strong class="text-blue-950">選擇前考量:</strong> {p.bestFor}
            </p>
            <ul class="list-disc list-inside text-sm text-slate-700 space-y-1 mb-4 chinese-line-height">
              {p.highlights.map((h) => <li>{h}</li>)}
            </ul>
            <div class="border-l-4 border-teal-600 bg-teal-50/50 p-4 rounded-r-lg">
              <p class="text-sm text-blue-950 leading-relaxed chinese-line-height">
                <strong>🩺 陳醫師點評:</strong> {p.chenNote}
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Prep Section -->
    <section id="prep" class="mb-14">
      <h2 class="text-2xl font-bold text-blue-950 mb-6">健檢前準備</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <h3 class="font-bold text-blue-950 mb-3">一般注意事項</h3>
          <ul class="list-disc list-inside text-sm text-slate-700 space-y-2 chinese-line-height">
            {GENERAL_PREP.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <h3 class="font-bold text-blue-950 mb-3">含無痛胃腸鏡(H、舒適健檢)</h3>
          <ul class="list-disc list-inside text-sm text-slate-700 space-y-2 chinese-line-height">
            {ENDO_PREP.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <div class="mt-8 rounded-xl border border-amber-200 bg-amber-50/60 p-6">
        <h3 class="text-lg font-bold text-blue-950 mb-3">清腸前，向檢查團隊確認這四件事</h3>
        <p class="text-sm text-slate-700 mb-4 leading-relaxed">本頁不提供通用清腸劑量、固定服藥時刻或停藥指示。請以健診中心本次給你的書面衛教單為準。</p>
        <ul class="list-disc pl-5 text-sm text-slate-700 space-y-3 leading-relaxed">
          {BOWEL_PREP_CHECKLIST.map((item) => <li>{item}</li>)}
        </ul>
        <p class="text-xs text-slate-600 mt-4 leading-relaxed">
          腎臟或心臟疾病、懷孕可能、曾有腸阻塞或無法大量飲水，請在預約時告知。
          <a href={BOWEL_PREP_SOURCE_URL} class="text-teal-800 underline" target="_blank" rel="noopener noreferrer">參考：2025 多專科大腸鏡清腸共識</a>。
        </p>
      </div>
    </section>

    <!-- Transit -->
    <section id="transit" class="mb-14">
      <h2 class="text-2xl font-bold text-blue-950 mb-4">交通資訊</h2>
      <p class="text-slate-700 mb-6">
        <strong>{LOCATION}</strong>
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <h3 class="font-bold text-blue-950 mb-3">🚗 自行開車</h3>
          <ul class="list-disc list-inside text-sm text-slate-700 space-y-2 chinese-line-height">
